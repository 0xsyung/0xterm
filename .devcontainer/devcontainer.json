{
  "name": "0xterm Web3 Terminal Environment",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "nodeGypDependencies": true
    }
  },
  "remoteEnv": {
    "PATH": "/home/node/.foundry/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "tailwindCSS.emmetCompletions": true
      },
      "extensions": [
        "bradlc.vscode-tailwindcss",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "dsznajder.es7-react-js-snippets"
      ]
    }
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Next.js Web Server",
      "onAutoForward": "openPreview"
    }
  },
  "postCreateCommand": "bash -c 'curl -L https://foundry.paradigm.xyz | bash && /home/node/.foundry/bin/foundryup && npm install'"
}
